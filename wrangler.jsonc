{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sales-mail-studio",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENVIRONMENT": "development",
    "MAIL_PROVIDER": "mock"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "34001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sales-mail-studio-db",
      "database_id": "36e72fe2-0133-427b-bab6-ded96d90904e",
      "preview_database_id": "sales-mail-studio-local",
      "migrations_dir": "./migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "MAIL_QUEUE", "queue": "sales-mail-studio-mail" }],
    "consumers": [
      {
        "queue": "sales-mail-studio-mail",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "sales-mail-studio-mail-dlq"
      }
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "production": {
      "name": "sales-mail-studio-production",
      "vars": {
        "ENVIRONMENT": "production",
        "MAIL_PROVIDER": "mock"
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "34001",
          "simple": { "limit": 60, "period": 60 }
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sales-mail-studio-db",
          "database_id": "36e72fe2-0133-427b-bab6-ded96d90904e",
          "preview_database_id": "sales-mail-studio-local",
          "migrations_dir": "./migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "MAIL_QUEUE", "queue": "sales-mail-studio-mail" }],
        "consumers": [
          {
            "queue": "sales-mail-studio-mail",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
            "max_concurrency": 1,
            "dead_letter_queue": "sales-mail-studio-mail-dlq"
          }
        ]
      }
    }
  }
}
